@{
    var cart = Context.Session.GetObject<List<CartItem>>("Cart");
    var cartCount = cart?.Sum(i => i.Quantity) ?? 0;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mini Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Products" asp-action="Index">🛍️ Mini Store</a>
            <div class="ms-auto">
                <a class="btn btn-outline-light position-relative" asp-controller="Cart" asp-action="Index">
                    🛒 السلة
                    @if (cartCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill">@cartCount</span>
                    }
                </a>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["Message"] is string msg)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @msg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>